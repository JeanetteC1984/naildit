# Stripe TEST-mode secret key (starts with sk_test_). Never put a live key here.
STRIPE_SECRET_KEY=

# Signing secret of the Stripe webhook for /api/stripe/webhook (starts with whsec_). Optional locally.
STRIPE_WEBHOOK_SECRET=

# Password for Nail'd Ops at /ops.
OPS_PASSWORD=

# Postgres connection URL for the shared database. Leave blank locally to keep data in .data/.
DATABASE_URL=
